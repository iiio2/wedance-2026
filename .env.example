# Database. For local development use the Docker Postgres + dev proxy from the
# quick start (/docs/getting-started):
#   DATABASE_URL=postgresql://dev:dev@localhost:5441/wedance
#   NEON_FETCH_ENDPOINT=http://localhost:4444/sql   # `bun run dev:db-proxy`
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe payment processing.
# Get these from https://dashboard.stripe.com/apikeys (use test keys for dev).
# Required by the ticketCheckout tRPC procedure and the Stripe webhook handler.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TicketTailor webhook signing secret.
# Get this from your TicketTailor account: Settings → Webhooks → create or open a webhook → Signing Secret.
# Required by /api/webhooks/tickettailor to verify HMAC-SHA256 signatures on incoming order events.
TICKETTAILOR_WEBHOOK_SECRET=

# Cloudinary image upload (profile photos).
# Get these from https://console.cloudinary.com/settings/api-keys
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
