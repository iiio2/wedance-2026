{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build",
    "vercel-build": "bun scripts/db-migrate.ts --deploy && nuxt build",
    "db:migrate:deploy": "bun scripts/db-migrate.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:tokens": "vitest run scripts/design-guardrails",
    "test:design": "playwright test -c playwright.design.config.ts contract a11y",
    "test:visual": "playwright test -c playwright.design.config.ts visual",
    "test:argos": "playwright test -c playwright.argos.config.ts",
    "test:visual:update": "playwright test -c playwright.design.config.ts visual --update-snapshots",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run server/database/seed.ts",
    "sync:v3-events": "bun scripts/sync-v3-events.ts",
    "dev:db-proxy": "bun scripts/dev/neon-http-proxy.ts",
    "seed:pinakothek": "bun scripts/seed-pinakothek.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nuxt": "^10.67.0",
    "@tailwindcss/vite": "^4.2.1",
    "@trpc/client": "^11.14.1",
    "@trpc/server": "^11.14.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "firebase-scrypt": "^2.2.0",
    "lucide-vue-next": "^0.577.0",
    "nuxt": "^4.4.2",
    "posthog-js": "^1.400.1",
    "qrcode": "^1.5.4",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.2",
    "resend": "^6.9.4",
    "shadcn-nuxt": "^2.4.3",
    "sharp": "^0.35.5",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "valibot": "^1.5.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610",
  "devDependencies": {
    "@argos-ci/cli": "^6.9.6",
    "@argos-ci/playwright": "^7.7.1",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.89.0",
    "pg": "^8.23.1",
    "playwright-bdd": "^8.5.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.1"
  }
}
